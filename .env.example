# 複製為 .env 後填入實際值(.env 已列入 .gitignore,不會進 repo)
# 金鑰與密碼產生方式:python -c "import secrets; print(secrets.token_urlsafe(50))"

# 本機開發設為 1;對外環境(含 docker compose)一律為 0
DJANGO_DEBUG=1

# DJANGO_DEBUG=0 時必填,長度至少 50 字元
DJANGO_SECRET_KEY=

# 允許的主機名稱,以逗號分隔;對外測試時加入 tunnel 網域,以及 Agent 連線用的區網 IP
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 以 HTTPS 對外提供服務時必填,須包含 https://,例如 https://powershare.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# 本機開發資料庫;未設定時使用 backend/db.sqlite3
# DATABASE_URL=postgres://powershare:<密碼>@localhost:5432/powershare

# 使用者上傳與成果的存放目錄;未設定時使用 backend/data
# DJANGO_DATA_DIR=

# docker compose 的 PostgreSQL 密碼,必填,僅使用英數字、- 與 _
POSTGRES_PASSWORD=

# 用量取樣與儀表板(README §4.9);未設定時使用 settings.py 的預設值
# USAGE_SAMPLE_SECONDS=60        每台設備最多每幾秒留一筆狀態取樣
# USAGE_RETENTION_DAYS=14        取樣保留天數(每日彙整永久保存)

# 互動式租借(README §4.10)
# RENTAL_MAX_MINUTES=120         單次租借時數上限
# RENTAL_DAILY_MINUTES=240       每人每日租借時數上限

# LLM API key(AI 助理使用,擇一)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
