# 複製為 .env 後填入實際值(.env 已列入 .gitignore,不會進 repo)

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 資料庫:未設定時使用 backend/db.sqlite3;正式環境改為 PostgreSQL 連線字串
# DATABASE_URL=postgres://powershare:powershare@localhost:5432/powershare

# 機台 Agent 呼叫心跳 API 時使用的共用金鑰(後端與 Agent 須一致)
AGENT_TOKEN=change-me

# LLM API key(AI 助理使用,擇一)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
